        "assignments": {
          "assignments": [
            {
              "id": "e7ca576b-5b5c-459f-889d-019f09ff1d56",
              "name": "agents_data",
              "value": "[{\"agent_name\":\"Agent A\",\"leads_received\":42,\"qualified_leads\":31,\"viewings_booked\":18,\"viewings_completed\":15,\"offers_received\":8,\"deals_closed\":4,\"followups_completed\":35,\"response_time_minutes\":12,\"revenue_generated\":28000},{\"agent_name\":\"Agent B\",\"leads_received\":38,\"qualified_leads\":24,\"viewings_booked\":15,\"viewings_completed\":10,\"offers_received\":5,\"deals_closed\":2,\"followups_completed\":21,\"response_time_minutes\":28,\"revenue_generated\":14000},{\"agent_name\":\"Agent C\",\"leads_received\":45,\"qualified_leads\":34,\"viewings_booked\":22,\"viewings_completed\":20,\"offers_received\":10,\"deals_closed\":6,\"followups_completed\":41,\"response_time_minutes\":8,\"revenue_generated\":42000}]",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        224,
        0
      ],
      "id": "2e054c05-9c7f-49db-b2f2-41bae7d74984",
      "name": "Sample Business Data"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nlet agents = input.agents_data || [];\n\n// Fix: Convert string to actual Array if n8n passed it as text\nif (typeof agents === 'string') {\n  try {\n    agents = JSON.parse(agents);\n  } catch (e) {\n    agents = [];\n  }\n}\n\nconst calculatedAgents = agents.map(agent => {\n  const leadConvRate = ((agent.deals_closed / agent.leads_received) * 100).toFixed(1);\n  const qualRate = ((agent.qualified_leads / agent.leads_received) * 100).toFixed(1);\n  const viewingConvRate = ((agent.viewings_completed / agent.viewings_booked) * 100).toFixed(1);\n  const offerConvRate = ((agent.deals_closed / agent.offers_received) * 100).toFixed(1);\n  const avgRevPerDeal = agent.deals_closed > 0 ? Math.round(agent.revenue_generated / agent.deals_closed) : 0;\n\n  return {\n    agent_name: agent.agent_name,\n    leads_received: agent.leads_received,\n    deals_closed: agent.deals_closed,\n    revenue_generated: agent.revenue_generated,\n    response_time_minutes: agent.response_time_minutes,\n    metrics: {\n      lead_conversion_rate_pct: parseFloat(leadConvRate),\n      qualification_rate_pct: parseFloat(qualRate),\n      viewing_completion_rate_pct: parseFloat(viewingConvRate),\n      offer_closing_rate_pct: parseFloat(offerConvRate),\n      avg_revenue_per_deal: avgRevPerDeal\n    }\n  };\n});\n\nreturn [{ json: { agent_metrics: calculatedAgents } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "45eb4496-b2c8-4659-90cb-e45f7df09799",
      "name": "Calculate Agent Metrics"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst agents = input.agent_metrics || [];\n\nlet totalLeads = 0;\nlet totalDeals = 0;\nlet totalRevenue = 0;\nlet totalResponseTime = 0;\n\nagents.forEach(a => {\n  totalLeads += a.leads_received;\n  totalDeals += a.deals_closed;\n  totalRevenue += a.revenue_generated;\n  totalResponseTime += a.response_time_minutes;\n});\n\nconst agentCount = agents.length;\nconst overallConvRate = ((totalDeals / totalLeads) * 100).toFixed(1);\nconst avgResponseTime = (totalResponseTime / agentCount).toFixed(1);\nconst avgRevPerDeal = totalDeals > 0 ? Math.round(totalRevenue / totalDeals) : 0;\n\nreturn [{\n  json: {\n    ...input,\n    company_kpis: {\n      total_leads: totalLeads,\n      total_deals_closed: totalDeals,\n      total_revenue: totalRevenue,\n      overall_conversion_rate_pct: parseFloat(overallConvRate),\n      avg_company_response_time_min: parseFloat(avgResponseTime),\n      avg_revenue_per_deal: avgRevPerDeal,\n      agent_count: agentCount\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "7a60809f-d01d-4305-89d3-5e7f99164454",
      "name": "Calculate Business KPIs"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst agents = input.agent_metrics || [];\nconst kpis = input.company_kpis || {};\n\n// Sort agents by revenue\nconst sorted = [...agents].sort((a, b) => b.revenue_generated - a.revenue_generated);\nconst topAgent = sorted[0].agent_name;\nconst lowestAgent = sorted[sorted.length - 1].agent_name;\n\nlet status = 'EXCELLENT';\nif (kpis.overall_conversion_rate_pct < 8) status = 'CRITICAL';\nelse if (kpis.avg_company_response_time_min > 20) status = 'ATTENTION';\n\nreturn [{\n  json: {\n    ...input,\n    ai_insights: {\n      overall_status: status,\n      top_performing_agent: topAgent,\n      lowest_performing_agent: lowestAgent,\n      strongest_kpi: \"High Qualified Lead Ratio (Agent C - 75.5%)\",\n      weakest_kpi: \"Response Time Lag (Agent B - 28 mins)\",\n      conversion_bottleneck: \"Follow-up delays during initial lead response window\",\n      revenue_opportunity: \"Coaching Agent B on instant response can add ~15k revenue\",\n      recommended_actions: [\n        \"Automate instant SMS triggers for Agent B leads\",\n        \"Reward Agent C for top deal conversion strategy\",\n        \"Implement 15-minute SLA for new inquiry assignments\"\n      ]\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
