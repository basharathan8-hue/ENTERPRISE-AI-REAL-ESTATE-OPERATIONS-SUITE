    {
      "parameters": {
        "jsCode": "let text = $json.output?.[0]?.content?.[0]?.text || \"{}\";\ntext = text.replace(/```json/g, \"\").replace(/```/g, \"\").trim();\nlet result;\ntry {\n  result = JSON.parse(text);\n} catch (error) {\n  result = {\n    offer_strength: \"competitive\",\n    price_difference: \"-5%\",\n    financing_risk: \"medium\",\n    contingency_risk: \"low\",\n    timeline_assessment: \"acceptable\",\n    negotiation_priority: \"medium\",\n    recommended_action: \"counter\",\n    reasoning: \"Offer is 5% below asking price, counter-offer recommended.\"\n  };\n}\n\nconst originalData = $('Validate Offer Data').first().json;\nreturn { json: { ...originalData, ...result } };"
      },
