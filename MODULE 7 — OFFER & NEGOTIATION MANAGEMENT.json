    {
      "parameters": {
        "jsCode": "const inputData = $json;\n\n// Check inside body or root level\nconst o = inputData.body ? inputData.body : inputData;\n\nconst missing = [];\n\nif (!o.offer_id) missing.push(\"offer_id\");\nif (!o.buyer_id) missing.push(\"buyer_id\");\nif (!o.property_id) missing.push(\"property_id\");\nif (!o.asking_price) missing.push(\"asking_price\");\nif (!o.offer_amount) missing.push(\"offer_amount\");\nif (!o.agent_id) missing.push(\"agent_id\");\n\n// Output clean data\nreturn {\n  json: {\n    offer_id: o.offer_id || \"OFF-1001\",\n    buyer_id: o.buyer_id || \"BUY-2001\",\n    buyer_name: o.buyer_name || \"John Smith\",\n    buyer_email: o.buyer_email || \"john@example.com\",\n    property_id: o.property_id || \"PROP-301\",\n    property_address: o.property_address || \"123 Main Street\",\n    asking_price: Number(o.asking_price || 500000),\n    offer_amount: Number(o.offer_amount || 475000),\n    financing_type: o.financing_type || \"Mortgage\",\n    contingencies: o.contingencies || [\"Inspection\"],\n    closing_preference: o.closing_preference || \"30 days\",\n    agent_id: o.agent_id || \"AGENT-101\",\n    validation_status: missing.length === 0 ? \"complete\" : \"incomplete\",\n    missing_fields: missing\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
