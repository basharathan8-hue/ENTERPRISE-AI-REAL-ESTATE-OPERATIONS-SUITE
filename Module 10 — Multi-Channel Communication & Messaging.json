    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst refId = 'COMM-' + Date.now().toString(36).toUpperCase();\n\nlet recipient = input.email;\nif (input.channel === 'whatsapp' || input.channel === 'sms') {\n  recipient = input.phone;\n} else if (input.channel === 'staff') {\n  recipient = 'Internal Team';\n}\n\nreturn [{\n  json: {\n    referenceId: refId,\n    recipient: recipient,\n    channel: input.channel || \"email\",\n    messageType: input.messageType || \"general\",\n    contactName: input.contactName || \"Client\",\n    email: input.email || \"\",\n    phone: input.phone || \"\",\n    propertyAddress: input.propertyAddress || \"Property\",\n    appointmentDate: input.appointmentDate || \"TBD\",\n    agentName: input.agentName || \"Agent\",\n    rawMessage: input.message || \"\",\n    priority: (input.messageType || \"\").includes('offer') ? 'HIGH' : 'NORMAL',\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
