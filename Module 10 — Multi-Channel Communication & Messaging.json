      "parameters": {
        "jsCode": "const input = $input.first() ? $input.first().json : {};\n\nif (!input.channel || !input.delivery_status) {\n  return [{\n    json: {\n      success: false,\n      channel: input.channel || \"unknown\",\n      recipient: \"N/A\",\n      messageType: \"N/A\",\n      status: \"unsupported_channel\",\n      error: \"Requested communication channel is not supported or delivery failed.\"\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    success: true,\n    channel: input.channel,\n    recipient: input.recipient,\n    messageType: input.messageType,\n    status: input.delivery_status,\n    referenceId: input.referenceId,\n    timestamp: input.sent_at\n  }\n}];"
