      "parameters": {
        "jsCode": "const p = $json;\nreturn {\n  json: {\n    ...p,\n    property_id: p.property_id || \"PROP-1001\",\n    property_title: p.property_title || \"Untitled Property\",\n    property_type: p.property_type || \"Other\",\n    city: p.city || \"Unknown\",\n    price: Number(p.price || 0),\n    bedrooms: Number(p.bedrooms || 0),\n    bathrooms: Number(p.bathrooms || 0),\n    listing_type: p.listing_type || \"For Sale\",\n    status: p.status || \"Available\"\n  }\n};"
      },
