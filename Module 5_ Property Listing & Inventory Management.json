          "value": "gpt-5-mini",
          "mode": "list",
          "cachedResultName": "GPT-5-MINI"
        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You are an AI Real Estate Property Classification Engine.\nAnalyze the property information and return ONLY valid JSON.\n\nDetermine:\n- property_category (Villa, Apartment, House, Commercial, Land, Office, Other)\n- market_segment (Luxury, Premium, Mid-Market, Affordable, Investment)\n- price_band (Standard, High-End, Budget)\n- listing_quality (Excellent, Good, Needs Review)\n- recommended_status (Available, Needs Review)\n- key_features (Array of strings)\n\nReturn JSON only."
            },
            {
              "content": "=={{ JSON.stringify($json) }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        672,
        0
      ],
      "id": "0de02762-b908-4715-8fe8-12b98aa50e02",
      "name": "Message a model",
      "credentials": {
        "openAiApi": {
          "id": "8FNGo8A7W6g93tKx",
          "name": "n8n free OpenAI API credits"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "let text = $json.output?.[0]?.content?.[0]?.text || \"{}\";\ntext = text.replace(/```json/g, \"\").replace(/```/g, \"\").trim();\nlet result;\ntry {\n  result = JSON.parse(text);\n} catch (error) {\n  result = {\n    property_category: \"Other\",\n    market_segment: \"Mid-Market\",\n    price_band: \"Standard\",\n    listing_quality: \"Needs Review\",\n    recommended_status: \"Available\",\n    key_features: []\n  };\n}\nreturn { json: { ...result } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
