      "id": "bcdbbf03-352c-4bdd-ac7e-91371ccce7e4",
      "name": "Normalize Buyer Requirements"
    },
    {
      "parameters": {
        "jsCode": "const b = $json;\nreturn {\n  json: {\n    buyer_name: b.buyer_name || \"Valued Client\",\n    email: b.email || \"client@example.com\",\n    city: b.city || \"Dubai\",\n    budget_min: Number(b.budget_min || 0),\n    budget_max: Number(b.budget_max || 1000000),\n    bedrooms: Number(b.bedrooms || 2),\n    bathrooms: Number(b.bathrooms || 1),\n    property_type: b.property_type || \"Any\",\n    min_area: Number(b.min_area || 0),\n    preferred_features: Array.isArray(b.preferred_features) ? b.preferred_features : [],\n    purpose: b.purpose || \"Buy\"\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "203b7adc-0245-4d65-9bd9-18582fb1c49a",
      "name": "Validate Buyer Requirements"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-5-mini",
          "mode": "list",
          "cachedResultName": "GPT-5-MINI"
        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You are an AI Real Estate Buyer Preference Extraction Engine.\nAnalyze the buyer requirements and return ONLY valid JSON.\n\nExtract and normalize:\n- city\n- property_type\n- budget_min\n- budget_max\n- bedrooms_min\n- bathrooms_min\n- area_min\n- purpose\n- preferred_features (Array)\n- deal_breakers (Array)\n\nReturn JSON only."
            },
            {
              "content": "=={{ JSON.stringify($json) }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        672,
        0
      ],
      "id": "97e62fcf-1a22-4c83-a6eb-bfcb72f660a5",
      "name": "AI Buyer Preference Engine",
      "credentials": {
        "openAiApi": {
          "id": "8FNGo8A7W6g93tKx",
          "name": "n8n free OpenAI API credits"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "let text = $json.output?.[0]?.content?.[0]?.text || \"{}\";\ntext = text.replace(/```json/g, \"\").replace(/```/g, \"\").trim();\nlet result;\ntry {\n  result = JSON.parse(text);\n} catch (error) {\n  result = {\n    city: \"Dubai\",\n    property_type: \"Apartment\",\n    budget_max: 800000,\n    bedrooms_min: 3,\n    bathrooms_min: 2,\n    area_min: 1500,\n    preferred_features: [\"Pool\", \"Parking\", \"Gym\"],\n    deal_breakers: []\n  };\n}\nreturn { json: { ...result } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        0
      ],
      "id": "906c3d98-6c1f-43a0-a540-eac3ab68e866",
      "name": "Parse AI Buyer Profile"
    },
    {
      "parameters": {
        "jsCode": "return [\n  { json: { property_id: \"PROP-1001\", property_title: \"Modern Executive Apartment\", city: \"Dubai\", property_type: \"Apartment\", price: 750000, bedrooms: 3, bathrooms: 2, area: 1600, features: [\"Pool\", \"Parking\", \"Gym\"] } },\n  { json: { property_id: \"PROP-1002\", property_title: \"Luxury Palm Villa\", city: \"Dubai\", property_type: \"Villa\", price: 1450000, bedrooms: 4, bathrooms: 4, area: 3200, features: [\"Pool\", \"Garden\", \"Parking\"] } },\n  { json: { property_id: \"PROP-1003\", property_title: \"Cozy Studio Downtown\", city: \"Dubai\", property_type: \"Apartment\", price: 620000, bedrooms: 2, bathrooms: 2, area: 1300, features: [\"Parking\", \"Gym\"] } },\n  { json: { property_id: \"PROP-1004\", property_title: \"Marina Sunset Suite\", city: \"Dubai\", property_type: \"Apartment\", price: 790000, bedrooms: 3, bathrooms: 2, area: 1700, features: [\"Pool\", \"Parking\"] } },\n  { json: { property_id: \"PROP-1005\", property_title: \"Business Bay Highrise\", city: \"Dubai\", property_type: \"Apartment\", price: 820000, bedrooms: 3, bathrooms: 3, area: 1800, features: [\"Gym\", \"Parking\"] } },\n  { json: { property_id: \"PROP-1006\", property_title: \"Jumeirah Beach Residence\", city: \"Dubai\", property_type: \"Apartment\", price: 780000, bedrooms: 3, bathrooms: 2, area: 1550, features: [\"Pool\", \"Parking\", \"Gym\", \"Beach Access\"] } },\n  { json: { property_id: \"PROP-1007\", property_title: \"Suburban Townhouse\", city: \"Abu Dhabi\", property_type: \"Townhouse\", price: 700000, bedrooms: 3, bathrooms: 3, area: 2000, features: [\"Garden\", \"Parking\"] } },\n  { json: { property_id: \"PROP-1008\", property_title: \"Creek Horizon Apartment\", city: \"Dubai\", property_type: \"Apartment\", price: 740000, bedrooms: 3, bathrooms: 2, area: 1500, features: [\"Pool\", \"Gym\"] } },\n  { json: { property_id: \"PROP-1009\", property_title: \"Luxury Penthouse\", city: \"Dubai\", property_type: \"Apartment\", price: 2100000, bedrooms: 4, bathrooms: 4, area: 4000, features: [\"Pool\", \"Parking\", \"Gym\", \"Elevator\"] } },\n  { json: { property_id: \"PROP-1010\", property_title: \"Budget City Flat\", city: \"Dubai\", property_type: \"Apartment\", price: 500000, bedrooms: 1, bathrooms: 1, area: 800, features: [\"Parking\"] } }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1264,
        0
      ],
      "id": "2c365bda-9ab9-4fa1-a4e4-894d06e0504f",
      "name": "Property Inventory Dataset"
    },
    {
      "parameters": {
        "jsCode": "const buyer = $('Parse AI Buyer Profile').first().json;\nconst property = $json;\n\n// Hard Filters Check\nif (buyer.city && buyer.city !== \"Any\" && property.city.toLowerCase() !== buyer.city.toLowerCase()) return [];\nif (buyer.property_type && buyer.property_type !== \"Any\" && property.property_type.toLowerCase() !== buyer.property_type.toLowerCase()) return [];\nif (buyer.budget_max && property.price > buyer.budget_max) return [];\nif (buyer.bedrooms_min && property.bedrooms < buyer.bedrooms_min) return [];\n\nreturn { json: { ...property, buyer_name: buyer.buyer_name || \"James Wilson\" } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1488,
        0
      ],
      "id": "fb256bec-a21d-49bb-9449-f80e61f5d4f6",
      "name": "AI Property Matching Engine"
    },
    {
      "parameters": {
        "jsCode": "const buyer = $('Parse AI Buyer Profile').first().json;\nconst p = $json;\n\nlet score = 0;\n\n// Price Fit (25 pts)\nif (p.price <= buyer.budget_max) score += 25;\n\n// Property Type (20 pts)\nif (p.property_type.toLowerCase() === buyer.property_type.toLowerCase()) score += 20;\n\n// Bedrooms (15 pts)\nif (p.bedrooms >= (buyer.bedrooms_min || 0)) score += 15;\n\n// Bathrooms (10 pts)\nif (p.bathrooms >= (buyer.bathrooms_min || 0)) score += 10;\n\n// Area (10 pts)\nif (p.area >= (buyer.area_min || 0)) score += 10;\n\n// Preferred Features (15 pts)\nconst prefFeatures = buyer.preferred_features || [];\nif (prefFeatures.length > 0 && p.features) {\n  const matched = prefFeatures.filter(f => p.features.includes(f));\n  score += Math.round((matched.length / prefFeatures.length) * 15);\n}\n\n// Location Fit (5 pts)\nif (p.city.toLowerCase() === (buyer.city || \"\").toLowerCase()) score += 5;\n\nlet match_level = \"Weak Match\";\nif (score >= 90) match_level = \"Excellent Match\";\nelse if (score >= 75) match_level = \"Strong Match\";\nelse if (score >= 60) match_level = \"Good Match\";\n\nreturn {\n  json: {\n    ...p,\n    match_score: score,\n    match_level: match_level\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
