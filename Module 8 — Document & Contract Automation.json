          "values": [
            {
              "role": "system",
              "content": "You are an Enterprise Real Estate Document Automation AI Engine.\nYour task is to generate structured document drafts based on input deal data.\n\nSTRICT Enterprise Guidelines:\n1. Identify the requested document_type.\n2. Populate all required fields into a clean markdown structure.\n3. Highlight any missing critical details explicitly.\n4. Maintain formal legal-styled real estate contract terminology, BUT DO NOT state or claim that this generated output constitutes binding legal advice or a finalized execution-ready contract without legal review.\n\nRespond STRICTLY in JSON format with the following keys:\n{\n  \"document_title\": \"Title of the document\",\n  \"document_type\": \"Type requested\",\n  \"document_content\": \"Detailed generated markdown draft content...\",\n  \"required_fields\": [\"buyer_name\", \"seller_name\", \"property_address\", \"offer_amount\", \"closing_date\", \"agent_name\"],\n  \"status\": \"DRAFTED\"\n}"
            },
            {
              "content": "=Generate draft for:\nDeal ID: {{ $json.deal_id }}\nType: {{ $json.document_type }}\nBuyer: {{ $json.buyer_name }} ({{ $json.buyer_email }})\nSeller: {{ $json.seller_name }} ({{ $json.seller_email }})\nProperty: {{ $json.property_address }} (ID: {{ $json.property_id }})\nAgreed Price: ${{ $json.offer_amount }}\nClosing Date: {{ $json.closing_date }}\nAgent: {{ $json.agent_name }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
