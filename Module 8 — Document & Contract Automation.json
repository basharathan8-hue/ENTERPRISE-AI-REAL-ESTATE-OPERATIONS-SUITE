    {
      "parameters": {
        "jsCode": "// Parse input data from previous nodes\nconst rawAiOutput = $json.message?.content || $json.text || $json;\nlet aiData = {};\n\ntry {\n  aiData = typeof rawAiOutput === 'string' ? JSON.parse(rawAiOutput) : rawAiOutput;\n} catch (e) {\n  aiData = { document_content: String(rawAiOutput) };\n}\n\n// Get original deal data from Node 2\nconst dealData = $('Normalize Deal Data').first().json;\n\n// Mandatory Fields Check\nconst requiredKeys = [\n  'buyer_name',\n  'seller_name',\n  'property_address',\n  'offer_amount',\n  'closing_date',\n  'agent_name'\n];\n\nconst missingFields = [];\n\nrequiredKeys.forEach(field => {\n  if (!dealData[field] || String(dealData[field]).trim() === '') {\n    missingFields.push(field);\n  }\n});\n\nconst isDataValid = missingFields.length === 0;\n\nreturn {\n  json: {\n    ...dealData,\n    document_title: aiData.document_title || `${dealData.document_type} - ${dealData.property_id}`,\n    document_content: aiData.document_content || \"Draft content generated.\",\n    missing_fields: missingFields,\n    validation_status: isDataValid ? \"READY\" : \"NEEDS_REVIEW\"\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
