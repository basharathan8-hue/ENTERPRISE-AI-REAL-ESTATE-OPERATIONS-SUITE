    {
      "parameters": {
        "jsCode": "const item = $json;\n\nreturn {\n  json: {\n    customer_name: item.customer_name || \"Unknown Lead\",\n    lead_type: item.lead_type || \"Buyer\",\n    budget: item.budget || \"0\",\n    city: item.city || \"Not Specified\",\n    property_type: item.property_type || \"General Property\",\n    urgency: item.urgency || \"Medium\"\n  }\n};"
      },
