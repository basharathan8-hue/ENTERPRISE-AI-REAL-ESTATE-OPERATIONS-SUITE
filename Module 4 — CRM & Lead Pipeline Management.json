    {
      "parameters": {
        "jsCode": "const agents = [\"Alex Mercer\", \"Sarah Johnson\", \"David Miller\", \"Emma Watson\"];\nconst randomIndex = Math.floor(Math.random() * agents.length);\nconst assignedAgent = agents[randomIndex];\n\nconst itemData = $json || {};\n\nreturn {\n  json: {\n    ...itemData,\n    assigned_agent: assignedAgent,\n    pipeline_stage: \"Viewing Scheduled\",\n    crm_status: \"Active - Hot Lead\",\n    follow_up_date: \"2026-08-08\"\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1264,
