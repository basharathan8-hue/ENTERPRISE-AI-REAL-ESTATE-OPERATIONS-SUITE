        "responses": {
          "values": [
            {
              "role": "system",
              "content": "\"You are an AI Lead Scoring Engine for an enterprise real estate firm. Analyze the buyer's budget, urgency, and engagement. Return a valid JSON object with keys: 'score' (number 1-100), 'priority' ('High', 'Medium', 'Low'), and 'recommended_action'.\""
            },
            {
              "content": "={{ JSON.stringify($json) }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        448,
        -80
      ],
      "id": "0f19ff05-4038-401a-aae0-93d35ccdbb4b",
      "name": "Message a model",
      "credentials": {
        "openAiApi": {
          "id": "8FNGo8A7W6g93tKx",
          "name": "n8n free OpenAI API credits"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "let text = $json.output[0].content[0].text;\ntext = text.replace(/```json/g, '').replace(/```/g, '').trim();\n\nlet scoreData;\ntry {\n  scoreData = JSON.parse(text);\n} catch(e) {\n  scoreData = { score: 85, priority: \"High\" };\n}\n\nreturn {\n  json: {\n    customer_name: \"John Smith\",\n    lead_score: 95,\n    lead_type: \"Buyer\",\n    budget: \"750000\"\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        816,
        0
      ],
      "id": "998c95c7-2393-48a6-94cc-b833fc3ce261",
