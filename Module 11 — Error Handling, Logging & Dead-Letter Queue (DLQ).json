      "id": "acee1951-96a1-47fd-bfdf-0bc45c3efd87",
      "name": "Normalize Error"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\n// Generate Unique Error ID\nconst dateStr = new Date().toISOString().slice(0, 10).replace(/-/g, '');\nconst randomHash = Math.random().toString(36).substring(2, 6).toUpperCase();\nconst errorId = `ERR-${dateStr}-REAL-${randomHash}`;\n\nreturn [{\n  json: {\n    error_id: errorId,\n    error_message: input.error_message,\n    workflow_name: input.workflow_name,\n    workflow_id: input.workflow_id,\n    execution_id: input.execution_id,\n    node_name: input.node_name,\n    timestamp: input.timestamp,\n    retry_count: 0,\n    source: \"n8n_core\",\n    status: \"OPEN\"\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "2924d0c8-3b3f-4050-a9bf-be64eaa4f7ef",
      "name": "Generate Error ID"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst msg = (input.error_message || '').toLowerCase();\nconst node = (input.node_name || '').toLowerCase();\n\nlet severity = 'MEDIUM';\nlet error_type = 'SYSTEM_ERROR';\nlet retryable = true;\nlet likely_cause = 'Unexpected system execution error';\nlet recommended_action = 'Review workflow execution logs';\n\n// Enterprise Classification Logic\nif (msg.includes('crm') || msg.includes('database') || msg.includes('booking') || node.includes('payment')) {\n  severity = 'CRITICAL';\n  error_type = 'CRITICAL_SYSTEM_FAILURE';\n  retryable = false;\n  likely_cause = 'Core database, CRM, or Booking gateway failure';\n  recommended_action = 'Escalate immediately to Ops Lead & System Admin';\n} else if (msg.includes('404') || msg.includes('auth') || msg.includes('unauthorized') || msg.includes('syntax')) {\n  severity = 'HIGH';\n  error_type = 'CONFIG_OR_AUTH_ERROR';\n  retryable = false;\n  likely_cause = 'API credentials expired or endpoint path changed';\n  recommended_action = 'Verify API credentials and payload structure';\n} else if (msg.includes('timeout') || msg.includes('500') || msg.includes('503') || msg.includes('rate limit')) {\n  severity = 'HIGH';\n  error_type = 'TRANSIENT_API_FAILURE';\n  retryable = true;\n  likely_cause = 'External service temporarily overloaded or offline';\n  recommended_action = 'Execute retry sequence with exponential backoff';\n} else if (msg.includes('format') || msg.includes('validation')) {\n  severity = 'LOW';\n  error_type = 'DATA_VALIDATION_WARNING';\n  retryable = false;\n  likely_cause = 'Incoming lead provided missing or malformed fields';\n  recommended_action = 'Log to audit record and monitor trend';\n}\n\nreturn [{\n  json: {\n    ...input,\n    ai_classification: {\n      error_type: error_type,\n      severity: severity,\n      retryable: retryable,\n      likely_cause: likely_cause,\n      recommended_action: recommended_action\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        0
      ],
      "id": "b3ec92de-9277-485d-9faa-aa9ef48f888f",
